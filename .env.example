# Copy to .env — NEVER commit real secrets. The app runs fully without any of these.
PORT=8791
# SQLite file (local-first). Default: data/app.db
DB_PATH=data/app.db
# --- Optional AI adapters (disabled by default; deterministic fallback always works) ---
# When set, the server may call the Claude API for (a) fallback field extraction and (b) plain-language
# exception explanations. Model output is schema-validated and grounded; it can never change a decision.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to "1" to allow the Claude adapters at all (a key alone is not enough)
ENABLE_LLM=0
